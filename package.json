{
  "name": "react-multistep",
  "version": "8.0.0",
  "description": "Responsive, headless ReactJS multistep form component",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles": "./dist/multistep.css",
    "./styles/tokens.css": "./dist/tokens.css",
    "./styles/chrome.css": "./dist/chrome.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": {
    "name": "@djidja8",
    "email": "srdjan@timok.com",
    "url": "https://github.com/srdjan"
  },
  "keywords": [
    "react",
    "reactjs",
    "headless",
    "responsive",
    "multistep",
    "form",
    "wizard",
    "component"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/srdjan/react-multistep.git"
  },
  "homepage": "https://github.com/srdjan/react-multistep",
  "bugs": {
    "url": "https://github.com/srdjan/react-multistep/issues"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "esbuild": "^0.25.10",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --sourcemap=linked --jsx=automatic --external:react --external:react/jsx-runtime --outfile=dist/index.js && tsc --emitDeclarationOnly --outDir dist && node --input-type=commonjs -e \"const fs=require('node:fs');for(const f of ['multistep.css','tokens.css','chrome.css'])fs.copyFileSync('src/styles/'+f,'dist/'+f)\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "node test/run.mjs",
    "lint": "eslint src test",
    "lint:fix": "eslint src test --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\"",
    "prepack": "npm run lint && npm run typecheck && npm run test && npm run build"
  }
}
